{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's profile information.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "URL of the user's profile picture."
        }
      },
      "required": ["displayName", "email"]
    },
    "Certificate": {
      "title": "Certificate",
      "description": "Represents an official certificate issued by ITLC India.",
      "type": "object",
      "properties": {
        "certificate_number": {
          "type": "string",
          "description": "The unique identifier for the certificate."
        },
        "student_name": {
          "type": "string",
          "description": "The name of the recipient."
        },
        "course_name": {
          "type": "string",
          "description": "The name of the program or internship."
        },
        "start_date": {
          "type": "string",
          "description": "Program start date."
        },
        "completion_date": {
          "type": "string",
          "description": "Program completion date."
        },
        "issue_date": {
          "type": "string",
          "description": "Date the certificate was issued."
        },
        "verification_id": {
          "type": "string",
          "description": "Public verification ID."
        },
        "certificate_file_url": {
          "type": "string",
          "format": "uri",
          "description": "URL to the PDF or image file of the certificate."
        },
        "status": {
          "type": "string",
          "enum": ["Verified", "Revoked"],
          "description": "Current validity status of the certificate."
        }
      },
      "required": ["certificate_number", "student_name", "course_name", "status"]
    }
  },
  "auth": {
    "providers": ["email"]
  },
  "firestore": {
    "/certificates/{certificateId}": {
      "schema": { "$ref": "#/backend/entities/Certificate" },
      "description": "Collection of issued certificates."
    }
  }
}
